<Layouts.auth flash={@flash} current_scope={@current_scope}>

  <p style="font-size:21px;font-weight:400;color:rgba(0,0,0,0.82);margin-bottom:6px;line-height:1.3;">
    Create your account
  </p>
  <p style="font-size:13px;color:rgba(0,0,0,0.4);margin-bottom:28px;line-height:1.6;">
    Already have one? <a href={~p"/users/log-in"} class="auth-link">Sign in</a>
  </p>

  <.form :let={f} for={@changeset} action={~p"/users/register"}>
    <div class="auth-field">
      <label class="auth-label" for="reg_email">Email</label>
      <input
        id="reg_email"
        class="auth-input"
        type="email"
        name={f[:email].name}
        value={Phoenix.HTML.Form.normalize_value("email", f[:email].value)}
        autocomplete="username"
        spellcheck="false"
        required
        autofocus
        placeholder="you@example.com"
      />
      <p :if={f[:email].errors != []} class="auth-error">
        {f[:email].errors |> Enum.map(fn {msg, _} -> msg end) |> Enum.join(", ")}
      </p>
    </div>

    <button
      class="auth-btn auth-btn-primary"
      type="submit"
      phx-disable-with="Creating…"
      style="margin-top:8px;"
    >
      Create account →
    </button>
  </.form>

  <p style="margin-top:22px;font-size:12px;color:rgba(0,0,0,0.3);text-align:center;line-height:1.6;">
    You'll receive a confirmation email to complete setup.
    <span :if={local_mail_adapter?()}>
      <br/><a href="/dev/mailbox" class="auth-link">Open dev mailbox</a>
    </span>
  </p>

</Layouts.auth>
