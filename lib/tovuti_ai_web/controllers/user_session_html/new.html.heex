<Layouts.auth flash={@flash} current_scope={@current_scope}>

  <p style="font-size:21px;font-weight:400;color:rgba(0,0,0,0.82);margin-bottom:6px;line-height:1.3;">
    <%= if @current_scope, do: "Confirm identity", else: "Welcome back" %>
  </p>
  <p style="font-size:13px;color:rgba(0,0,0,0.4);margin-bottom:28px;line-height:1.6;">
    <%= if @current_scope do %>
      Re-authenticate to continue.
    <% else %>
      New here? <a href={~p"/users/register"} class="auth-link">Create an account</a>
    <% end %>
  </p>

  <%!-- Password sign-in --%>
  <.form :let={f} for={@form} as={:user} id="login_form_password" action={~p"/users/log-in"}>
    <div class="auth-field">
      <label class="auth-label" for="pw_email">Email</label>
      <input
        id="pw_email"
        class="auth-input"
        type="email"
        name={f[:email].name}
        value={Phoenix.HTML.Form.normalize_value("email", f[:email].value)}
        autocomplete="username"
        spellcheck="false"
        readonly={!!@current_scope}
        required
        autofocus
      />
    </div>

    <div class="auth-field">
      <label class="auth-label" for="pw_password">Password</label>
      <input
        id="pw_password"
        class="auth-input"
        type="password"
        name={f[:password].name}
        autocomplete="current-password"
        spellcheck="false"
      />
    </div>

    <label style="display:flex;align-items:center;gap:9px;margin-bottom:22px;cursor:pointer;">
      <input
        type="checkbox"
        name={f[:remember_me].name}
        value="true"
        checked
        style="accent-color:#7c3aed;width:15px;height:15px;cursor:pointer;flex-shrink:0;"
      />
      <span style="font-size:13px;color:rgba(0,0,0,0.4);">Keep me signed in</span>
    </label>

    <button class="auth-btn auth-btn-primary" type="submit" phx-disable-with="Signing in…">
      Sign in →
    </button>
  </.form>

  <%!-- Magic-link fallback --%>
  <div class="auth-divider">or</div>

  <.form :let={g} for={@form} as={:user} id="login_form_magic" action={~p"/users/log-in"}>
    <div class="auth-field">
      <label class="auth-label" for="ml_email">Email — get a sign-in link</label>
      <input
        id="ml_email"
        class="auth-input"
        type="email"
        name={g[:email].name}
        value={Phoenix.HTML.Form.normalize_value("email", g[:email].value)}
        autocomplete="username"
        spellcheck="false"
        readonly={!!@current_scope}
        placeholder="you@example.com"
      />
    </div>
    <button class="auth-btn auth-btn-ghost" type="submit" phx-disable-with="Sending…">
      Send sign-in link
    </button>
  </.form>

  <div :if={local_mail_adapter?()} style="margin-top:18px;font-size:12px;color:rgba(0,0,0,0.28);text-align:center;line-height:1.5;">
    Dev mode · <a href="/dev/mailbox" class="auth-link">open mailbox</a> to see sign-in links
  </div>

</Layouts.auth>
