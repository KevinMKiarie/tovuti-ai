<div
  id="settings-root"
  phx-hook="AudioPlayer"
  class="flex h-screen w-screen overflow-hidden bg-[#fafafa] dark:bg-[#0a0a0a] text-gray-900 dark:text-[#e8e8e8] antialiased"
>

  <nav class="flex flex-col shrink-0 py-3 border-r border-black/[0.06] dark:border-white/[0.06] w-[52px] items-center">
    <button
      phx-click="back"
      class="w-9 h-9 flex items-center justify-center rounded-lg transition-all duration-150 text-black/40 hover:text-black/80 hover:bg-black/[0.07] dark:text-white/40 dark:hover:text-white/80 dark:hover:bg-white/[0.07]"
      title="Back to chat"
    >
      <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
  </nav>

  <div class="flex flex-col flex-1 min-w-0 overflow-hidden">

    <%!-- Header + tab bar --%>
    <div class="px-8 pt-8 shrink-0">
      <h1 class="text-xl font-light tracking-tight text-black/90 dark:text-white/90">Settings</h1>
      <p class="text-sm text-black/40 dark:text-white/40 mt-0.5">Configure your local AI deployment</p>

      <div class="flex gap-1 mt-6 border-b border-black/[0.06] dark:border-white/[0.06]">
        <button
          phx-click="switch_tab"
          phx-value-tab="models"
          class={[
            "px-4 py-2 text-sm -mb-px border-b-2 transition-all duration-150",
            @tab == "models" && "border-black/70 dark:border-white/70 text-black/90 dark:text-white/90 font-medium",
            @tab != "models" && "border-transparent text-black/40 dark:text-white/40 hover:text-black/70 dark:hover:text-white/70"
          ]}
        >
          Models
        </button>
        <button
          phx-click="switch_tab"
          phx-value-tab="voices"
          class={[
            "px-4 py-2 text-sm -mb-px border-b-2 transition-all duration-150",
            @tab == "voices" && "border-black/70 dark:border-white/70 text-black/90 dark:text-white/90 font-medium",
            @tab != "voices" && "border-transparent text-black/40 dark:text-white/40 hover:text-black/70 dark:hover:text-white/70"
          ]}
        >
          Voice
        </button>
        <button
          phx-click="switch_tab"
          phx-value-tab="connectors"
          class={[
            "px-4 py-2 text-sm -mb-px border-b-2 transition-all duration-150",
            @tab == "connectors" && "border-black/70 dark:border-white/70 text-black/90 dark:text-white/90 font-medium",
            @tab != "connectors" && "border-transparent text-black/40 dark:text-white/40 hover:text-black/70 dark:hover:text-white/70"
          ]}
        >
          Connectors
        </button>
        <button
          phx-click="switch_tab"
          phx-value-tab="contacts"
          class={[
            "px-4 py-2 text-sm -mb-px border-b-2 transition-all duration-150",
            @tab == "contacts" && "border-black/70 dark:border-white/70 text-black/90 dark:text-white/90 font-medium",
            @tab != "contacts" && "border-transparent text-black/40 dark:text-white/40 hover:text-black/70 dark:hover:text-white/70"
          ]}
        >
          Contacts
          <%= if @contacts != [] do %>
            <span class="ml-1 text-[10px] font-semibold px-1.5 py-0.5 rounded-full bg-black/[0.06] dark:bg-white/[0.06] text-black/50 dark:text-white/50">
              <%= length(@contacts) %>
            </span>
          <% end %>
        </button>
      </div>
    </div>

    <%!-- Tab content --%>
    <div class="flex-1 overflow-y-auto px-8 py-6">

      <%!-- Loading state --%>
      <%= if @loading do %>
        <div class="flex items-center justify-center h-48">
          <div class="flex items-center gap-2 text-black/30 dark:text-white/30 text-sm">
            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            Loading…
          </div>
        </div>

      <% else %>

        <%!-- ── Models tab ── --%>
        <%= if @tab == "models" do %>
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3 max-w-5xl">
            <%= for model <- @models do %>
              <% pull_state = Map.get(@pulling, model.name) %>
              <% is_active = model.name == @active_model %>
              <% is_installed = model.installed || (pull_state != nil && pull_state.done) %>

              <div class={[
                "bg-white dark:bg-[#141414] border rounded-xl p-4 flex flex-col gap-3 transition-colors duration-150",
                is_active && "border-violet-500/40 dark:border-violet-400/30",
                not is_active && "border-black/[0.08] dark:border-white/[0.07]"
              ]}>
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-sm font-medium"><%= model.label %></span>
                      <%= if is_active do %>
                        <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400 shrink-0">
                          Active
                        </span>
                      <% end %>
                    </div>
                    <p class="text-xs text-black/40 dark:text-white/40 mt-0.5 leading-relaxed">
                      <%= model.description %>
                    </p>
                  </div>
                  <div class="flex flex-col items-end gap-1.5 shrink-0">
                    <span class="text-[10px] text-black/30 dark:text-white/30 font-mono"><%= model.size %></span>
                    <%= if is_installed do %>
                      <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-500/10 dark:bg-emerald-400/10 text-emerald-600 dark:text-emerald-400">
                        Installed
                      </span>
                    <% end %>
                  </div>
                </div>

                <%= if pull_state && !pull_state.done do %>
                  <div class="space-y-1.5">
                    <div class="h-1 bg-black/[0.06] dark:bg-white/[0.08] rounded-full overflow-hidden">
                      <div
                        class="h-full bg-gradient-to-r from-violet-500 to-teal-400 rounded-full transition-[width] duration-300"
                        style={"width: #{pull_state.percent}%"}
                      />
                    </div>
                    <p class="text-[10px] text-black/40 dark:text-white/40 capitalize">
                      <%= if pull_state.status == "error", do: "Pull failed — check Ollama is running", else: pull_state.status %>
                    </p>
                  </div>
                <% end %>

                <div class="mt-auto">
                  <%= if is_installed do %>
                    <button
                      phx-click="select_model"
                      phx-value-name={model.name}
                      disabled={is_active}
                      class={[
                        "w-full py-1.5 rounded-lg text-xs font-medium transition-all duration-150",
                        is_active && "bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400 cursor-default",
                        not is_active && "bg-black/[0.05] dark:bg-white/[0.06] text-black/70 dark:text-white/70 hover:bg-black/[0.09] dark:hover:bg-white/[0.10]"
                      ]}
                    >
                      <%= if is_active, do: "In use", else: "Use this model" %>
                    </button>
                  <% else %>
                    <%= if pull_state && !pull_state.done && pull_state.status != "error" do %>
                      <div class="w-full py-1.5 rounded-lg text-xs font-medium text-center text-black/30 dark:text-white/30 select-none">
                        Downloading · <%= pull_state.percent %>%
                      </div>
                    <% else %>
                      <button
                        phx-click="pull_model"
                        phx-value-name={model.name}
                        class="w-full py-1.5 rounded-lg text-xs font-medium transition-all duration-150 bg-black/[0.05] dark:bg-white/[0.06] text-black/70 dark:text-white/70 hover:bg-black/[0.09] dark:hover:bg-white/[0.10]"
                      >
                        <%= if pull_state && pull_state.status == "error", do: "Retry pull", else: "Pull model" %>
                      </button>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%!-- ── Voice tab ── --%>
        <%= if @tab == "voices" do %>
          <div class="max-w-xl space-y-8">

            <%!-- Engine badge --%>
            <div class="flex items-center gap-2">
              <span class="text-[10px] uppercase tracking-widest text-black/30 dark:text-white/30 select-none">Engine</span>
              <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400">
                Chatterbox TTS
              </span>
            </div>

            <%!-- ── Voice clone selection ── --%>
            <div>
              <p class="text-[10px] uppercase tracking-widest text-black/30 dark:text-white/30 mb-3 select-none">Voice</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">

                <%!-- Default voice card --%>
                <% is_default_active = is_nil(@active_voice_id) && is_nil(@active_template) %>
                <div class={[
                  "bg-white dark:bg-[#141414] border rounded-xl p-4 flex items-center justify-between gap-3 transition-colors duration-150",
                  is_default_active && "border-violet-500/40 dark:border-violet-400/30",
                  not is_default_active && "border-black/[0.08] dark:border-white/[0.07]"
                ]}>
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-medium">Default</span>
                      <%= if is_default_active do %>
                        <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400">
                          Active
                        </span>
                      <% end %>
                    </div>
                    <p class="text-xs text-black/40 dark:text-white/40 mt-0.5">Chatterbox built-in voice</p>
                  </div>
                  <button
                    phx-click="use_default_voice"
                    disabled={is_default_active}
                    class={[
                      "shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-150",
                      is_default_active && "bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400 cursor-default",
                      not is_default_active && "bg-black/[0.05] dark:bg-white/[0.06] text-black/70 dark:text-white/70 hover:bg-black/[0.09] dark:hover:bg-white/[0.10]"
                    ]}
                  >
                    <%= if is_default_active, do: "Selected", else: "Use" %>
                  </button>
                </div>

                <%!-- Saved voice clone cards --%>
                <%= for voice <- @voices do %>
                  <% is_active = voice.id == @active_voice_id %>
                  <div class={[
                    "bg-white dark:bg-[#141414] border rounded-xl p-4 flex items-center justify-between gap-3 transition-colors duration-150",
                    is_active && "border-violet-500/40 dark:border-violet-400/30",
                    not is_active && "border-black/[0.08] dark:border-white/[0.07]"
                  ]}>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-sm font-medium truncate"><%= voice.name %></span>
                        <%= if is_active do %>
                          <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400 shrink-0">
                            Active
                          </span>
                        <% end %>
                      </div>
                      <p class="text-xs text-black/40 dark:text-white/40 mt-0.5">Cloned voice</p>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                      <button
                        phx-click="select_voice"
                        phx-value-id={voice.id}
                        disabled={is_active}
                        class={[
                          "px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-150",
                          is_active && "bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400 cursor-default",
                          not is_active && "bg-black/[0.05] dark:bg-white/[0.06] text-black/70 dark:text-white/70 hover:bg-black/[0.09] dark:hover:bg-white/[0.10]"
                        ]}
                      >
                        <%= if is_active, do: "Selected", else: "Use" %>
                      </button>
                      <button
                        phx-click="delete_voice"
                        phx-value-id={voice.id}
                        title="Delete voice"
                        class="w-7 h-7 flex items-center justify-center rounded-lg text-black/30 dark:text-white/30 hover:text-red-500 dark:hover:text-red-400 hover:bg-red-500/[0.08] transition-all duration-150"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 6h18M19 6l-1 14H6L5 6M10 11v6M14 11v6M9 6V4h6v2"/>
                        </svg>
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <%!-- ── Voice templates ── --%>
            <%= if @voice_templates != [] do %>
              <div>
                <p class="text-[10px] uppercase tracking-widest text-black/30 dark:text-white/30 mb-3 select-none">Voice Templates</p>
                <p class="text-xs text-black/40 dark:text-white/40 mb-3">
                  Pre-built Kokoro voices — natural, high-quality speech with accent-specific intonation.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <%= for t <- @voice_templates do %>
                    <% is_active = @active_template == t["id"] %>
                    <div class={[
                      "bg-white dark:bg-[#141414] border rounded-xl p-4 flex items-center justify-between gap-3 transition-colors duration-150",
                      is_active && "border-violet-500/40 dark:border-violet-400/30",
                      not is_active && "border-black/[0.08] dark:border-white/[0.07]"
                    ]}>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2 flex-wrap">
                          <%!-- gender icon --%>
                          <%= if t["gender"] == "female" do %>
                            <svg class="w-3.5 h-3.5 shrink-0 text-pink-400" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M12 2a5 5 0 1 1 0 10A5 5 0 0 1 12 2zm0 12c-5.33 0-8 2.67-8 4v2h16v-2c0-1.33-2.67-4-8-4z"/>
                            </svg>
                          <% else %>
                            <svg class="w-3.5 h-3.5 shrink-0 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M12 2a5 5 0 1 1 0 10A5 5 0 0 1 12 2zm0 12c-5.33 0-8 2.67-8 4v2h16v-2c0-1.33-2.67-4-8-4z"/>
                            </svg>
                          <% end %>
                          <span class="text-sm font-medium truncate"><%= t["label"] %></span>
                          <%= if is_active do %>
                            <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400 shrink-0">
                              Active
                            </span>
                          <% end %>
                        </div>
                        <p class="text-xs text-black/40 dark:text-white/40 mt-0.5"><%= t["accent"] %></p>
                      </div>
                      <button
                        phx-click="select_template"
                        phx-value-id={t["id"]}
                        disabled={is_active}
                        class={[
                          "shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-150",
                          is_active && "bg-violet-500/10 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400 cursor-default",
                          not is_active && "bg-black/[0.05] dark:bg-white/[0.06] text-black/70 dark:text-white/70 hover:bg-black/[0.09] dark:hover:bg-white/[0.10]"
                        ]}
                      >
                        <%= if is_active, do: "Selected", else: "Use" %>
                      </button>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%!-- ── Voice parameters ── --%>
            <div>
              <p class="text-[10px] uppercase tracking-widest text-black/30 dark:text-white/30 mb-3 select-none">Parameters</p>
              <div class="space-y-3">

                <div class="bg-white dark:bg-[#141414] border border-black/[0.08] dark:border-white/[0.07] rounded-xl p-5 space-y-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm font-medium">Expressiveness</p>
                      <p class="text-xs text-black/40 dark:text-white/40 mt-0.5">
                        How emotional the voice sounds. Lower = flat, higher = vivid.
                      </p>
                    </div>
                    <span class="text-sm font-mono text-black/60 dark:text-white/60 shrink-0 ml-4">
                      <%= fmt(@tts_exaggeration) %>
                    </span>
                  </div>
                  <form phx-change="update_tts_param">
                    <input type="hidden" name="param" value="exaggeration" />
                    <input
                      type="range"
                      name="value"
                      min="0.25" max="2.0" step="0.05"
                      value={@tts_exaggeration}
                      class="w-full h-1.5 rounded-full appearance-none cursor-pointer accent-violet-500 bg-black/[0.08] dark:bg-white/[0.10]"
                    />
                    <div class="flex justify-between mt-1.5 text-[10px] text-black/25 dark:text-white/25 select-none">
                      <span>Flat</span>
                      <span>Natural</span>
                      <span>Vivid</span>
                    </div>
                  </form>
                </div>

                <div class="bg-white dark:bg-[#141414] border border-black/[0.08] dark:border-white/[0.07] rounded-xl p-5 space-y-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm font-medium">Consistency</p>
                      <p class="text-xs text-black/40 dark:text-white/40 mt-0.5">
                        Lower allows natural variation in pacing; higher enforces steady rhythm.
                      </p>
                    </div>
                    <span class="text-sm font-mono text-black/60 dark:text-white/60 shrink-0 ml-4">
                      <%= fmt(@tts_cfg_weight) %>
                    </span>
                  </div>
                  <form phx-change="update_tts_param">
                    <input type="hidden" name="param" value="cfg_weight" />
                    <input
                      type="range"
                      name="value"
                      min="0.0" max="1.0" step="0.05"
                      value={@tts_cfg_weight}
                      class="w-full h-1.5 rounded-full appearance-none cursor-pointer accent-violet-500 bg-black/[0.08] dark:bg-white/[0.10]"
                    />
                    <div class="flex justify-between mt-1.5 text-[10px] text-black/25 dark:text-white/25 select-none">
                      <span>Variable</span>
                      <span>Balanced</span>
                      <span>Steady</span>
                    </div>
                  </form>
                </div>

                <div class="bg-white dark:bg-[#141414] border border-black/[0.08] dark:border-white/[0.07] rounded-xl p-5 space-y-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm font-medium">Pace</p>
                      <p class="text-xs text-black/40 dark:text-white/40 mt-0.5">
                        Speaking speed. 1.0× is natural; lower is slower, higher is faster.
                      </p>
                    </div>
                    <span class="text-sm font-mono text-black/60 dark:text-white/60 shrink-0 ml-4">
                      <%= fmt(@tts_pace) %>×
                    </span>
                  </div>
                  <form phx-change="update_tts_param">
                    <input type="hidden" name="param" value="pace" />
                    <input
                      type="range"
                      name="value"
                      min="0.5" max="2.0" step="0.1"
                      value={@tts_pace}
                      class="w-full h-1.5 rounded-full appearance-none cursor-pointer accent-violet-500 bg-black/[0.08] dark:bg-white/[0.10]"
                    />
                    <div class="flex justify-between mt-1.5 text-[10px] text-black/25 dark:text-white/25 select-none">
                      <span>0.5×</span>
                      <span>1.0×</span>
                      <span>2.0×</span>
                    </div>
                  </form>
                </div>

              </div>
            </div>

            <%!-- ── Preview ── --%>
            <div class="bg-white dark:bg-[#141414] border border-black/[0.08] dark:border-white/[0.07] rounded-xl p-5 space-y-4">
              <div>
                <p class="text-sm font-medium">Preview</p>
                <p class="text-xs text-black/40 dark:text-white/40 mt-0.5">
                  Test the active voice and current parameter settings.
                </p>
              </div>
              <form phx-change="update_preview_text">
                <input
                  type="text"
                  name="text"
                  value={@preview_text}
                  placeholder="Type a phrase to preview…"
                  class="w-full bg-transparent text-sm text-gray-900 dark:text-white/90 placeholder:text-black/25 dark:placeholder:text-white/25 outline-none border border-black/[0.08] dark:border-white/[0.07] rounded-lg px-3 py-2 focus:border-black/[0.18] dark:focus:border-white/[0.15] transition-colors duration-150"
                />
              </form>
              <button
                phx-click="preview_voice"
                disabled={@preview_loading}
                class={[
                  "flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-150",
                  "bg-black/[0.05] dark:bg-white/[0.06] text-black/70 dark:text-white/70",
                  "hover:bg-black/[0.09] dark:hover:bg-white/[0.10]",
                  "disabled:opacity-40 disabled:cursor-not-allowed"
                ]}
              >
                <%= if @preview_loading do %>
                  <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"/>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                  </svg>
                  Generating…
                <% else %>
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  Play preview
                <% end %>
              </button>
            </div>

          </div>
        <% end %>

      <% end %>

      <%!-- ── Connectors tab ──────────────────────────────────────────────── --%>
      <%= if @tab == "connectors" do %>

        <div class="max-w-xl space-y-8">

          <%!-- Actions toggle --%>
          <div>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-black/80 dark:text-white/80">Voice Actions</p>
                <p class="text-xs text-black/40 dark:text-white/40 mt-0.5">
                  Let the AI take actions (send email, reschedule meetings, send WhatsApp) via your voice. Requires llama3.2 or qwen2.5.
                </p>
              </div>
              <button
                phx-click="toggle_actions"
                class={[
                  "relative inline-flex h-5 w-9 shrink-0 rounded-full transition-colors duration-200 focus:outline-none",
                  @actions_enabled && "bg-gray-900 dark:bg-white",
                  not @actions_enabled && "bg-black/10 dark:bg-white/10"
                ]}
              >
                <span
                  class={[
                    "inline-block h-4 w-4 transform rounded-full bg-white dark:bg-[#0a0a0a] shadow transition-transform duration-200 mt-0.5",
                    @actions_enabled && "translate-x-4",
                    not @actions_enabled && "translate-x-0.5"
                  ]}
                />
              </button>
            </div>
          </div>

          <div class="border-t border-black/[0.06] dark:border-white/[0.06]" />

          <%!-- Gmail --%>
          <div>
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-black/60 dark:text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <p class="text-sm font-medium text-black/80 dark:text-white/80">Gmail</p>
              <%= if @gmail_connected do %>
                <span class="text-[10px] font-semibold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 px-2 py-0.5 rounded-full">Connected</span>
              <% else %>
                <span class="text-[10px] font-semibold uppercase tracking-wider bg-black/[0.05] dark:bg-white/[0.05] text-black/40 dark:text-white/40 px-2 py-0.5 rounded-full">Not connected</span>
              <% end %>
            </div>
            <p class="text-xs text-black/40 dark:text-white/40 mb-3">
              Download OAuth 2.0 credentials from Google Cloud Console and save as
              <code class="bg-black/[0.05] dark:bg-white/[0.05] px-1 rounded text-[11px]">priv/action_config/gmail_credentials.json</code>.
              Then click Connect.
            </p>
            <div class="flex gap-2">
              <button
                phx-click="connect_gmail"
                disabled={@connector_loading}
                class="px-3 py-1.5 rounded-lg bg-black/[0.06] dark:bg-white/[0.07] text-sm text-black/70 dark:text-white/70 hover:bg-black/[0.1] dark:hover:bg-white/[0.11] disabled:opacity-40 transition-colors duration-150"
              >
                <%= if @connector_loading, do: "Loading…", else: "Connect Gmail" %>
              </button>
              <button
                phx-click="check_gmail_status"
                class="px-3 py-1.5 rounded-lg border border-black/[0.08] dark:border-white/[0.08] text-sm text-black/50 dark:text-white/50 hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors duration-150"
              >
                Check status
              </button>
            </div>
          </div>

          <div class="border-t border-black/[0.06] dark:border-white/[0.06]" />

          <%!-- Cal.com --%>
          <div>
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-black/60 dark:text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>
              </svg>
              <p class="text-sm font-medium text-black/80 dark:text-white/80">Cal.com</p>
              <%= if @calcom_api_key != "" do %>
                <span class="text-[10px] font-semibold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 px-2 py-0.5 rounded-full">Key set</span>
              <% end %>
              <%= if @calcom_username != "" do %>
                <span class="text-[10px] font-semibold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 px-2 py-0.5 rounded-full">Username set</span>
              <% end %>
            </div>
            <p class="text-xs text-black/40 dark:text-white/40 mb-3">
              Enter your Cal.com username (the part after cal.com/ in your booking link) — used to show your booking page inline when you say "create a meeting".
            </p>
            <form phx-submit="save_calcom_username" class="flex gap-2 mb-3">
              <input
                type="text"
                name="username"
                value={@calcom_username}
                placeholder="your-username"
                class="flex-1 bg-black/[0.03] dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/[0.08] rounded-lg px-3 py-1.5 text-sm outline-none focus:border-black/[0.2] dark:focus:border-white/[0.18] transition-colors duration-150 text-black/80 dark:text-white/80"
              />
              <button
                type="submit"
                class="px-3 py-1.5 rounded-lg bg-black/[0.06] dark:bg-white/[0.07] text-sm text-black/70 dark:text-white/70 hover:bg-black/[0.1] dark:hover:bg-white/[0.11] transition-colors duration-150"
              >
                Save
              </button>
            </form>
            <p class="text-xs text-black/40 dark:text-white/40 mb-2">
              API key — from cal.com/settings/developer/api-keys (for rescheduling).
            </p>
            <form phx-submit="save_calcom_key" class="flex gap-2">
              <input
                type="text"
                name="key"
                value={@calcom_api_key}
                placeholder="cal_live_..."
                class="flex-1 bg-black/[0.03] dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/[0.08] rounded-lg px-3 py-1.5 text-sm outline-none focus:border-black/[0.2] dark:focus:border-white/[0.18] transition-colors duration-150 text-black/80 dark:text-white/80"
              />
              <button
                type="submit"
                class="px-3 py-1.5 rounded-lg bg-black/[0.06] dark:bg-white/[0.07] text-sm text-black/70 dark:text-white/70 hover:bg-black/[0.1] dark:hover:bg-white/[0.11] transition-colors duration-150"
              >
                Save
              </button>
            </form>
          </div>

          <div class="border-t border-black/[0.06] dark:border-white/[0.06]" />

          <%!-- WhatsApp --%>
          <div>
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-black/60 dark:text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              <p class="text-sm font-medium text-black/80 dark:text-white/80">WhatsApp</p>
              <%= cond do %>
                <% @whatsapp_state == "open" -> %>
                  <span class="text-[10px] font-semibold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 px-2 py-0.5 rounded-full">Connected</span>
                <% @whatsapp_state in ["connecting", "qrReadSuccess"] -> %>
                  <span class="text-[10px] font-semibold uppercase tracking-wider bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 px-2 py-0.5 rounded-full">Connecting…</span>
                <% true -> %>
                  <span class="text-[10px] font-semibold uppercase tracking-wider bg-black/[0.05] dark:bg-white/[0.05] text-black/40 dark:text-white/40 px-2 py-0.5 rounded-full">Not connected</span>
              <% end %>
            </div>
            <p class="text-xs text-black/40 dark:text-white/40 mb-3">
              Evolution API (self-hosted WhatsApp). Click "Get QR code" and scan with your phone to connect.
              The Evolution API service must be running via docker compose.
            </p>
            <div class="flex gap-2 mb-4">
              <button
                phx-click="get_whatsapp_qr"
                disabled={@connector_loading}
                class="px-3 py-1.5 rounded-lg bg-black/[0.06] dark:bg-white/[0.07] text-sm text-black/70 dark:text-white/70 hover:bg-black/[0.1] dark:hover:bg-white/[0.11] disabled:opacity-40 transition-colors duration-150"
              >
                Get QR code
              </button>
              <button
                phx-click="refresh_whatsapp"
                class="px-3 py-1.5 rounded-lg border border-black/[0.08] dark:border-white/[0.08] text-sm text-black/50 dark:text-white/50 hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors duration-150"
              >
                Refresh status
              </button>
            </div>
            <%= if @whatsapp_qr && @whatsapp_qr != "" do %>
              <div class="bg-white rounded-xl p-3 w-fit">
                <img src={@whatsapp_qr} alt="WhatsApp QR code" class="w-48 h-48" />
              </div>
              <p class="text-xs text-black/40 dark:text-white/40 mt-2">
                Scan this with WhatsApp → Linked Devices → Link a Device
              </p>
            <% end %>
          </div>

        </div>

      <% end %>

      <%!-- ── Contacts tab ──────────────────────────────────────────────────── --%>
      <%= if @tab == "contacts" do %>
        <div class="max-w-xl space-y-6">

          <div>
            <p class="text-sm text-black/50 dark:text-white/50 leading-relaxed">
              Save contacts by name so you can say things like
              <span class="font-medium text-black/70 dark:text-white/70">"Send a WhatsApp to John and Mary saying..."</span>
              instead of typing phone numbers.
            </p>
          </div>

          <%!-- Add contact form --%>
          <div class="bg-white dark:bg-[#141414] border border-black/[0.08] dark:border-white/[0.07] rounded-xl p-5 space-y-3">
            <p class="text-sm font-medium">Add contact</p>
            <%= if @contact_error do %>
              <p class="text-xs text-red-500 dark:text-red-400"><%= @contact_error %></p>
            <% end %>
            <form phx-submit="add_contact" phx-change="update_contact_fields" class="flex gap-2">
              <input
                type="text"
                name="name"
                value={@contact_name}
                placeholder="Name (e.g. Mum)"
                autocomplete="off"
                class="flex-1 bg-black/[0.03] dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/[0.08] rounded-lg px-3 py-1.5 text-sm outline-none focus:border-black/[0.2] dark:focus:border-white/[0.18] transition-colors duration-150 text-black/80 dark:text-white/80"
              />
              <input
                type="text"
                name="phone"
                value={@contact_phone}
                placeholder="+254712345678"
                autocomplete="off"
                class="flex-1 bg-black/[0.03] dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/[0.08] rounded-lg px-3 py-1.5 text-sm outline-none focus:border-black/[0.2] dark:focus:border-white/[0.18] transition-colors duration-150 text-black/80 dark:text-white/80"
              />
              <button
                type="submit"
                disabled={@contact_name == "" || @contact_phone == ""}
                class="px-3 py-1.5 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-[#0a0a0a] text-sm font-medium hover:bg-black dark:hover:bg-[#e8e8e8] disabled:opacity-30 transition-colors duration-150 shrink-0"
              >
                Add
              </button>
            </form>
          </div>

          <%!-- Contacts list --%>
          <%= if @contacts == [] do %>
            <p class="text-sm text-black/30 dark:text-white/30 text-center py-8">
              No contacts yet. Add some above.
            </p>
          <% else %>
            <div class="space-y-1.5">
              <%= for contact <- @contacts do %>
                <div class="bg-white dark:bg-[#141414] border border-black/[0.08] dark:border-white/[0.07] rounded-xl px-4 py-3 flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-black/80 dark:text-white/80 truncate"><%= contact.name %></p>
                    <p class="text-xs text-black/40 dark:text-white/40 font-mono mt-0.5"><%= contact.phone %></p>
                  </div>
                  <button
                    phx-click="delete_contact"
                    phx-value-id={contact.id}
                    class="w-7 h-7 flex items-center justify-center rounded-lg text-black/30 dark:text-white/30 hover:text-red-500 dark:hover:text-red-400 hover:bg-red-500/[0.08] transition-all duration-150 shrink-0"
                    title="Remove contact"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 6h18M19 6l-1 14H6L5 6M10 11v6M14 11v6M9 6V4h6v2"/>
                    </svg>
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>

        </div>
      <% end %>

    </div>

  </div>
</div>
