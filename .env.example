# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── Cal.com ──────────────────────────────────────────────────────────────────
# Get from: https://cal.com/settings/developer/api-keys
CALCOM_API_KEY=

# ── WhatsApp (Evolution API) ──────────────────────────────────────────────────
# Self-hosted key — choose any secret string. Must match in docker-compose.yml
# for both the ai_service and evolution_api containers.
EVOLUTION_API_KEY=tovuti_evo_key_change_me
EVOLUTION_INSTANCE=tovuti

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# No env var needed — drop your OAuth credentials JSON into:
#   priv/action_config/gmail_credentials.json
# then connect via Settings → Connectors → Gmail.
